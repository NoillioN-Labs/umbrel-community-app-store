#!/usr/bin/env bash
set -euo pipefail
: "${APP_DATA_DIR:?Umbrel must supply APP_DATA_DIR}"
[[ ! -L "${APP_DATA_DIR}/data" ]] || { echo "Refusing symlinked app data" >&2; exit 1; }
install -d -m 0750 -o 1000 -g 1000 "${APP_DATA_DIR}/data"
for directory in suite node node-logs pilot zkas-node zkas-logs; do
  [[ ! -L "${APP_DATA_DIR}/data/${directory}" ]] || { echo "Refusing symlinked service data" >&2; exit 1; }
  install -d -m 0750 -o 1000 -g 1000 "${APP_DATA_DIR}/data/${directory}"
  # Repair earlier root-created files without following links or crossing mounts.
  find "${APP_DATA_DIR}/data/${directory}" -xdev ! -type l \( ! -user 1000 -o ! -group 1000 \) -exec chown --no-dereference 1000:1000 {} +
done
